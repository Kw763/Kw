<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.takeout.mapper.TakeoutPaymentMapper">

    <resultMap id="PaymentResult" type="TakeoutPayment">
        <id     property="paymentId"    column="payment_id"/>
        <result property="paymentNo"    column="payment_no"/>
        <result property="orderId"      column="order_id"/>
        <result property="userId"       column="user_id"/>
        <result property="amount"       column="amount"/>
        <result property="status"       column="status"/>
        <result property="transactionNo" column="transaction_no"/>
        <result property="paidTime"     column="paid_time"/>
        <result property="version"      column="version"/>
        <result property="createBy"     column="create_by"/>
        <result property="createTime"   column="create_time"/>
        <result property="updateBy"     column="update_by"/>
        <result property="updateTime"   column="update_time"/>
    </resultMap>

    <sql id="columns">
        payment_id, payment_no, order_id, user_id, amount, status, transaction_no, paid_time, version,
        create_by, create_time, update_by, update_time
    </sql>

    <insert id="insertPayment" parameterType="TakeoutPayment" useGeneratedKeys="true" keyProperty="paymentId">
        insert into takeout_payment (payment_no, order_id, user_id, amount, status, version,
            create_by, create_time)
        values (#{paymentNo}, #{orderId}, #{userId}, #{amount}, #{status}, 0,
            #{createBy}, sysdate())
    </insert>

    <select id="selectPaymentByOrderId" parameterType="Long" resultMap="PaymentResult">
        select <include refid="columns"/> from takeout_payment where order_id = #{orderId}
    </select>

    <select id="selectPaymentByOrderIdForUpdate" parameterType="Long" resultMap="PaymentResult">
        select <include refid="columns"/> from takeout_payment where order_id = #{orderId} for update
    </select>

    <update id="markPaymentSuccess">
        update takeout_payment set status = 'SUCCESS', transaction_no = #{transactionNo},
            paid_time = sysdate(), update_by = #{updateBy}, update_time = sysdate(), version = version + 1
        where payment_id = #{paymentId} and version = #{version}
    </update>

</mapper>
