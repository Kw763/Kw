<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.takeout.mapper.TakeoutStatusLogMapper">

    <resultMap id="StatusLogResult" type="TakeoutStatusLog">
        <id     property="logId"       column="log_id"/>
        <result property="bizType"     column="biz_type"/>
        <result property="bizId"       column="biz_id"/>
        <result property="fromStatus"  column="from_status"/>
        <result property="toStatus"    column="to_status"/>
        <result property="operatorId"  column="operator_id"/>
        <result property="operatorName" column="operator_name"/>
        <result property="createBy"    column="create_by"/>
        <result property="createTime"  column="create_time"/>
        <result property="remark"      column="remark"/>
    </resultMap>

    <sql id="columns">
        log_id, biz_type, biz_id, from_status, to_status, operator_id, operator_name,
        create_by, create_time, remark
    </sql>

    <insert id="insertStatusLog" parameterType="TakeoutStatusLog" useGeneratedKeys="true" keyProperty="logId">
        insert into takeout_status_log (biz_type, biz_id, from_status, to_status,
            operator_id, operator_name, create_by, create_time, remark)
        values (#{bizType}, #{bizId}, #{fromStatus}, #{toStatus},
            #{operatorId}, #{operatorName}, #{createBy}, sysdate(), #{remark})
    </insert>

    <select id="selectStatusLogList" parameterType="TakeoutStatusLog" resultMap="StatusLogResult">
        select <include refid="columns"/> from takeout_status_log
        <where>
            <if test="logId != null">and log_id = #{logId}</if>
            <if test="bizType != null and bizType != ''">and biz_type = #{bizType}</if>
            <if test="bizId != null">and biz_id = #{bizId}</if>
            <if test="operatorName != null and operatorName != ''">and operator_name like concat('%', #{operatorName}, '%')</if>
        </where>
        order by create_time asc, log_id asc
    </select>

    <select id="selectStatusLogById" parameterType="Long" resultMap="StatusLogResult">
        select <include refid="columns"/> from takeout_status_log where log_id = #{logId}
    </select>

</mapper>
